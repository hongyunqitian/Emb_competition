--cpu Cortex-M3
"hx711get\startup_stm32f103xb.o"
"hx711get\oled.o"
"hx711get\main.o"
"hx711get\gpio.o"
"hx711get\usart.o"
"hx711get\stm32f1xx_it.o"
"hx711get\stm32f1xx_hal_msp.o"
"hx711get\system_stm32f1xx.o"
"hx711get\stm32f1xx_hal_gpio_ex.o"
"hx711get\stm32f1xx_hal_tim.o"
"hx711get\stm32f1xx_hal_tim_ex.o"
"hx711get\stm32f1xx_hal_uart.o"
"hx711get\stm32f1xx_hal.o"
"hx711get\stm32f1xx_hal_rcc.o"
"hx711get\stm32f1xx_hal_rcc_ex.o"
"hx711get\stm32f1xx_hal_gpio.o"
"hx711get\stm32f1xx_hal_dma.o"
"hx711get\stm32f1xx_hal_cortex.o"
