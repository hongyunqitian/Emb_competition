   1          /*---------------------------------------------------------------------------------------------*/
   2          /* --- 电子秤(HX711)入门级教程 ----------------------------------------------------------------*/
   3          /* --- MCU：STC89C52RC ------------------------------------------------------------------------*/
   4          /* --- 作者：深圳小余电子 ---------------------------------------------------------------------*/
   5          /* --- 来源：https://nmcu.taobao.com/----------------------------------------------------------*/
   6          
   7          /* --- 功能：----------------------------------------------------------------------------------*/
   8          /* --- 按键K1为去皮功能,K2和K3是修改报警参数值.  K2加,K3减.  ----------------------------------*/
   9          /* --- 当所测重量大于设置的报警值时,P3.0驱动继电器工作,继电器可以接报警装置等.-----------------*/
  10          
  11          /* --- 校正方法：(校正系数具有断电保存功能)----------------------------------------------------*/
  12          /* --- 如果所测重量偏小。则按住K3键不放,再按下K1键.直到显示重量为正确重量时再放开K1和K3按键 ---*/
  13          /* --- 如果所测重量偏大。则按住K2键不放,再按下K1键.直到显示重量为正确重量时再放开K1和K2按键 ---*/
  14          /* --- 如果要在程序中使用此代码,请在程序中注明使用了作者的资料及程序 --------------------------*/
  15          /*---------------------------------------------------------------------------------------------*/
  16          #include "HX711.h"
  17          
  18          
  19          //****************************************************
  20          //延时函数
  21          //****************************************************
  22          void Delay__hx711_us(void)
  23          {
  24   1        _nop_();
  25   1        _nop_();
  26   1      }
  27          
  28          //****************************************************
  29          //读取HX711
  30          //****************************************************
  31          unsigned long HX711_Read(void)  //增益128
  32          {
  33   1        unsigned long count; 
  34   1        unsigned char i; 
  35   1          HX711_DOUT=1; 
  36   1        Delay__hx711_us();
  37   1          HX711_SCK=0; 
  38   1          count=0; 
  39   1          while(HX711_DOUT); 
  40   1          for(i=0;i<24;i++)
  41   1        { 
  42   2            HX711_SCK=1; 
  43   2            count=count<<1; 
  44   2          HX711_SCK=0; 
  45   2            if(HX711_DOUT)
  46   2            count++; 
  47   2        } 
  48   1        HX711_SCK=1; 
  49   1          count=count^0x800000;//第25个脉冲下降沿来时，转换数据
  50   1        Delay__hx711_us();
  51   1        HX711_SCK=0;  
  52   1        return(count);
  53   1      }
