  56          //连续写字符
  57          //****************************************************
  58          void LCD1602_write_word(unsigned char *s)
  59          {
  60   1        while(*s>0)
  61   1        {
  62   2          LCD1602_write_data(*s);
  63   2          s++;
  64   2        }
  65   1      }
  66          
  67          void Init_LCD1602()
  68          {
  69   1        LCD1602_EN = 0;
  70   1        LCD1602_RW = 0;           //设置为写状态
  71   1        LCD1602_write_com(0x38);      //显示模式设定
  72   1        LCD1602_write_com(0x0c);      //开关显示、光标有无设置、光标闪烁设置
  73   1        LCD1602_write_com(0x06);      //写一个字符后指针加一
  74   1        LCD1602_write_com(0x01);      //清屏指令
