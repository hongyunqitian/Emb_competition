  19          //****************************************************
  20          //MS延时函数(12M晶振下测试)
  21          //****************************************************
  22          void LCD1602_delay_ms(unsigned int n)
  23          {
  24   1        unsigned int  i,j;
  25   1        for(i=0;i<n;i++)
  26   1          for(j=0;j<123;j++);
  27   1      }
  28          
  29          //****************************************************
  30          //写指令
  31          //****************************************************
  32          void LCD1602_write_com(unsigned char com)
  33          {
  34   1        LCD1602_RS = 0;
  35   1        LCD1602_delay_ms(1);
  36   1        LCD1602_EN = 1;
  37   1        LCD1602_PORT = com;
  38   1        LCD1602_delay_ms(1);
  39   1        LCD1602_EN = 0;
  40   1      }
  41          
  42          //****************************************************
  43          //写数据
  44          //****************************************************
  45          void LCD1602_write_data(unsigned char dat)
  46          {
  47   1        LCD1602_RS = 1;
  48   1        LCD1602_delay_ms(1);  
  49   1        LCD1602_PORT = dat;
  50   1        LCD1602_EN = 1;
  51   1        LCD1602_delay_ms(1);
  52   1        LCD1602_EN = 0;
  53   1      }
  54          
