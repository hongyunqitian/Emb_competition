  42   1        LCD1602_delay_ms(1);  
  43   1        LCD1602_PORT = dat;
  44   1        LCD1602_EN = 1;
  45   1        LCD1602_delay_ms(1);
  46   1        LCD1602_EN = 0;
  47   1      }
