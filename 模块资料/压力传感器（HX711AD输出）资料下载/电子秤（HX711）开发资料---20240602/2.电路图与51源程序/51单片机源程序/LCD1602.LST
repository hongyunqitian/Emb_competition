  16          void LCD1602_delay_ms(unsigned int n)
  17          {
  18   1        unsigned int  i,j;
  19   1        for(i=0;i<n;i++)
  20   1          for(j=0;j<123;j++);
  21   1      }
  22          
  23          //****************************************************
  24          //写指令
  25          //****************************************************
  26          void LCD1602_write_com(unsigned char com)
  27          {
  28   1        LCD1602_RS = 0;
  29   1        LCD1602_delay_ms(1);
  30   1        LCD1602_EN = 1;
  31   1        LCD1602_PORT = com;
  32   1        LCD1602_delay_ms(1);
  33   1        LCD1602_EN = 0;
  34   1      }
  35          
  36          //****************************************************
  37          //写数据
  38          //****************************************************
  39          void LCD1602_write_data(unsigned char dat)
  40          {
