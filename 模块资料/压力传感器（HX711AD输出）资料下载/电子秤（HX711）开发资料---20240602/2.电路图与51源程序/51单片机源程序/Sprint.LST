  10          #include "Sprint.h"
  11          
  12          
  13          void Uart_Init()   //MCU：STC89C52RC   晶振：11.0592   波特率：9600            
  14          {
  15   1        SCON = 0X50;  //UART方式1；8位UART
  16   1        REN  = 0;     //不允许串行口接收数据
  17   1        PCON = 0x00;  //SMOD=0;波特率不加倍
  18   1        TMOD = 0x21;  //T1方式2，用于产生波特率
  19   1        TH1  = 0xFD;  //装初值
  20   1        TL1  = 0xFD;
  21   1        TR1  = 1;     //启动定时器1
  22   1        EA   = 1;     //打开全局中断控制
  23   1        ES   = 0;     //串行口中断  
  24   1      }
  25          
  26          void UartPutc(unsigned char dat)
  27          {
  28   1          SBUF = dat;
  29   1          while(TI==0);
  30   1          TI = 0;
  31   1      }
  32          
  33          char putchar(char c)
  34          {
  35   1          UartPutc(c);
  36   1          return c;
  37   1      }
