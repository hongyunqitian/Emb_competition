  15          //****************************************************
  16          //延时函数
  17          //****************************************************
  18          void Delay__hx711_us(void)
  19          {
  20   1        _nop_();
  21   1      }
  22          
  23          //****************************************************
  24          //读取HX711
  25          //****************************************************
  26          unsigned long HX711_Read(void)  //增益128
  27          {
  28   1        unsigned long count; 
  29   1        unsigned char i; 
  30   1      
  31   1        HX711_DOUT=1; 
  32   1        Delay__hx711_us();
  33   1        HX711_SCK=0; 
  34   1        count=0;
  35   1        while(HX711_DOUT); 
  36   1        for(i=0;i<24;i++)
  37   1         { 
  38   2          HX711_SCK=1; 
  39   2          count=count<<1; 
  40   2          HX711_SCK=0; 
  41   2          if(HX711_DOUT)
  42   2          count++; 
  43   2         } 
  44   1        HX711_SCK=1; 
  45   1        count=count^0x800000;//第25个脉冲下降沿来时，转换数据
  46   1        Delay__hx711_us();
  47   1        HX711_SCK=0;  
  48   1        return(count);
  49   1      }
