   1          /**********************************************************************************
   2           * 功能描述：控制IO口P1.0每隔5s循环切换高低电平输出
   3          **********************************************************************************/
   4          #include <reg52.h>             //库文件
   5          #define uchar unsigned char//宏定义无符号字符型
   6          #define uint unsigned int  //宏定义无符号整型
   7          #include <intrins.h>
   8          
   9          /********************************************************************
  10                                      I/O定义
  11          *********************************************************************/
  12          sbit OUT=P1^0;   //定义单片机P1口的第1位 （即P1.0）为驱动输出口
  13          /********************************************************************
  14                                      延时函数
  15          *********************************************************************/
  16          void delay()//延时程序
  17          {
  18   1      uchar m,n,s;
  19   1      for(m=20;m>0;m--)
  20   1      for(n=20;n>0;n--)
  21   1      for(s=248;s>0;s--);
  22   1      }
  23          void Delay5000ms()              //@11.0592MHz
  24          {
  25   1              unsigned char i, j, k;
  26   1      
  27   1              _nop_();
  28   1              i = 36;
  29   1              j = 5;
  30   1              k = 211;
  31   1              do
  32   1              {
  33   2                      do
  34   2                      {
  35   3                              while (--k);
  36   3                      } while (--j);
  37   2              } while (--i);
  38   1      }
  39          /********************************************************************
  40                                      主函数
  41          *********************************************************************/
  42          void main()
  43          {
  44   1              OUT=0;     //初始关闭
  45   1              while(1)   //无限循环
  46   1              {
  47   2                OUT=1;           //闭合
  48   2                      Delay5000ms();
  49   2                      OUT=0;     //关闭
  50   2                      Delay5000ms();
  51   2              }
  52   1      }       
  53          /********************************************************************
  54                                        结束
  55          *********************************************************************/
